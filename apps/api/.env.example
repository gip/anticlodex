# Required
DATABASE_URL=postgresql://localhost:5432/acx
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=sk_your_api_key

# API server
PORT=3001

# Optional Notion integration
# Redirect URI to register: <INTEGRATION_OAUTH_CALLBACK_ORIGIN>/v1/integrations/notion/callback
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
# Only set this if your Notion integration requires an explicit OAuth scope.
# NOTION_OAUTH_SCOPE=

# Optional Google Docs integration
# Redirect URI to register: <INTEGRATION_OAUTH_CALLBACK_ORIGIN>/v1/integrations/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/documents.readonly

# Required by either integration -- encrypts stored provider tokens at rest.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=your_base64_encoded_32_byte_key
# Where users are sent back to after OAuth (the web app origin).
INTEGRATION_CALLBACK_ORIGIN=http://localhost:3000
# The publicly reachable API origin the providers redirect back to.
INTEGRATION_OAUTH_CALLBACK_ORIGIN=http://localhost:3001

# Optional anonymous-response cache
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=acx:api-cache:
# REDIS_CACHE_TTL_SECONDS=60
