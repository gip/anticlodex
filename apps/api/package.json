{
  "name": "@acx/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "WORKOS_CLIENT_ID=client_test WORKOS_API_KEY=sk_test node --import tsx --experimental-test-module-mocks --test src/*.test.ts src/**/*.test.ts",
    "migrate": "node-pg-migrate up --config node-pg-migrate.config.cjs --migrations-dir db/migrations",
    "migrate:status": "node-pg-migrate up --dry-run --config node-pg-migrate.config.cjs --migrations-dir db/migrations",
    "migrate:down:last": "node-pg-migrate down 1 --config node-pg-migrate.config.cjs --migrations-dir db/migrations"
  },
  "dependencies": {
    "@acx/agent-runtime": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@openship/protocol": "0.0.1",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "unique-names-generator": "^4.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12"
  }
}
